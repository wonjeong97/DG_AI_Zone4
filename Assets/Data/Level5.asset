  m_Name: Level5
  m_EditorClassIdentifier: 
  storyText: "\uC774\uACF3\uC740 \uC778\uB958\uAC00 \uC0B4\uC544\uAC08 \uC218 \uC788\uB294
    \uC0C8\uB85C\uC6B4 \uC678\uACC4 \uD589\uC131\uC774\uC5D0\uC694.\r\n\r\n\uC548\uC804\uD55C
    \uC6B0\uC8FC \uB3C4\uC2DC\uB97C \uB9CC\uB4E4\uB824\uBA74 \uC138 \uAC00\uC9C0
    \uC2DC\uC2A4\uD15C\uC774 \uD544\uC694\uD574\uC694.\r\n\r<color=yellow>\n\u2022
    \uC6B0\uC8FC \uC815\uAC70\uC7A5\uC5D0\uC11C \uC0AC\uC6A9\uD55C \uAE30\uC9C0 \uC6B4\uC601
    \uCF54\uB4DC\r\n\u2022 \uD0D0\uC0AC \uB85C\uBD07\uC5D0\uC11C \uC0AC\uC6A9\uD55C
    \uC790\uC6D0 \uC218\uC9D1 \uCF54\uB4DC\r\n\u2022 \uC0C8\uB85C\uC6B4 \uB3C4\uC2DC\uB97C
    \uC5F0\uACB0\uD560 \uD1B5\uC2E0 \uC2DC\uC2A4\uD15C\r\n\r</color>\n<color=red>[\uD568\uC218]</color>
    \uBE14\uB85D\uC744 \uC0AC\uC6A9\uD574 \uD544\uC694\uD55C \uCF54\uB4DC\uB97C \uD55C
    \uBC88\uC5D0 \uC0AC\uC6A9\uD558\uAC8C \uD574\uC8FC\uC138\uC694.\r\n\uC138 \uAC00\uC9C0
    \uC2DC\uC2A4\uD15C\uC744 \uD558\uB098\uB85C \uC5F0\uACB0\uD558\uC5EC \uC678\uACC4
    \uD589\uC131\uC5D0 \uC548\uC804\uD558\uACE0 \uBA4B\uC9C4 \uC6B0\uC8FC \uB3C4\uC2DC\uB97C
    \uC644\uC131\uD574 \uBCFC\uAE4C\uC694?"
  missionText: "<color=red>[\uD568\uC218]</color>\uBE14\uB85D\uC744 \uC0AC\uC6A9\uD558\uACE0,
    <color=blue>[\uB3D9\uC791]</color> \uBE14\uB85D\uACFC \uC6B0\uC8FC \uB3C4\uC2DC\uC5D0
    \uD544\uC694\uD55C \L\uD589\uB3D9 \uCF54\uB4DC\uB97C \uC0AC\uC6A9\uD574 \uB3C4\uC2DC\uB97C
    \uC644\uC131\uD574 \uBCF4\uC138\uC694."
  destinations: []
  maxElectricityRange: {x: 3, y: 5}
  minOxygenRange: {x: 3, y: 5}
